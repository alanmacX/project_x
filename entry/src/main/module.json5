{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // API 26: native segmented controls, switches and dialogs use the system material.
    // Earlier compatible systems retain their native appearance.
    "metadata": [{ "name": "ohos.arkui.UIMaterial.state", "value": "enable" }],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:ability_desc",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindow": "$profile:start_window",
        "startWindowIcon": "$media:start_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          },
          {
            "actions": ["ohos.want.action.viewData"],
            "uris": [{"scheme":"file","type":"application/x-fridgememo","utd":"com.fridgememo.template","linkFeature":"FileOpen"}]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "TemplateShareAbility",
        "srcEntry": "./ets/share/TemplateShareAbility.ets",
        "type": "share",
        "exported": true,
        "label": "$string:app_name",
        "icon": "$media:app_icon",
        "skills": [{"actions":["ohos.want.action.sendData"],"uris":[{"scheme":"file","utd":"com.fridgememo.template","maxFileSupported":1}]}]
      },
      {
        "name": "FridgeFormAbility",
        "srcEntry": "./ets/form/FridgeFormAbility.ets",
        "description": "$string:form_desc",
        "type": "form",
        "exported": true,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ]
  }
}
