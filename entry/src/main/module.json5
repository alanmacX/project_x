{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // API 26: native segmented controls, switches and dialogs use the system material.
    // Earlier compatible systems retain their native appearance.
    "metadata": [{ "name": "ohos.arkui.UIMaterial.state", "value": "enable" }],
    "requestPermissions": [
      {
        // 云同步 / 天气 / 照片 URL 所需；normal 级，声明即可
        "name": "ohos.permission.INTERNET"
      }

    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:ability_desc",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindow": "$profile:start_window",
        "startWindowIcon": "$media:start_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "FridgeFormAbility",
        "srcEntry": "./ets/form/FridgeFormAbility.ets",
        "description": "$string:form_desc",
        "type": "form",
        "exported": true,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ]
  }
}
